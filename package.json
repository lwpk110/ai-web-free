{
  "name": "ai-web-free",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "sh -c 'SERVER_PORT=3000 PORT=3000 exec ./ai-web-free'",
    "start": "sh -c 'SERVER_PORT=3000 PORT=3000 exec ./ai-web-free'",
    "build": "sh -c 'cd web && ../node_modules/.bin/vite build && node scripts/export-prompt.mjs && cd .. && CGO_ENABLED=0 go build -trimpath -ldflags=\"-s -w\" -o ai-web-free .'",
    "lint": "sh -c 'cd web && ../node_modules/.bin/tsc --noEmit'"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.36",
    "@neon/config": "^1.14.4",
    "@neon/env": "^2.1.7",
    "@openuidev/lang-core": "^1.1.1",
    "@openuidev/react-headless": "^0.18.7",
    "@openuidev/react-lang": "^1.1.1",
    "@openuidev/react-ui": "^0.18.7",
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.67",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
