{
  "grill-me-adr-archiver": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./hooks/grill_me_adr.py --event PreInvocation",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/grill_me_adr.py --event PostToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./hooks/grill_me_adr.py --event Stop",
        "timeout": 15
      }
    ]
  }
}
