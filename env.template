# 覆盖优先级：POOL_<PROVIDER>_<TYPE>_<KEY> > POOL_<PROVIDER>_<KEY> > POOL_<KEY>
# POOL_CHATGPT_FREE_ACTIVE_TARGET=15
# POOL_CHATGPT_FREE_MIN_HEALTHY=8
# POOL_CHATGPT_FREE_MAX_ACTIVE=20
# POOL_CHATGPT_FREE_ROTATE_INTERVAL=24h
# POOL_CHATGPT_FREE_ROTATE_RATIO=0.2
# POOL_CHATGPT_FREE_ACTIVATE_BATCH=5

# ---------- xAI Grok Web 免费号池与多模态生图 ----------
# GROK_BASE_URL=https://grok.com
# GROK_ACCOUNTS_FILE=grok_accounts.txt
# CHROME_PATH=/usr/bin/chromium
# GROK_SSO_COOKIES=sso=...; sso-rw=...
# 可选：导入 auto 模式下无法确定性识别的凭据行时，批量交给 SiliconFlow 便宜模型做格式归一化。
# 该功能会把未识别的原始凭据发送给外部 LLM，因此默认关闭；启用前必须配置 SILICONFLOW_API_KEY。
# GROK_CREDENTIAL_LLM_ENABLED=false
# GROK_CREDENTIAL_LLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
# LLM 成功归一化后会自动保存脱敏格式模板到数据库；相同格式后续离线命中，不再调用模型。
# POOL_GROK_FREE_ACTIVE_TARGET=10
# POOL_GROK_FREE_MIN_HEALTHY=5
# POOL_GROK_FREE_MAX_ACTIVE=15
# POOL_GROK_FREE_ROTATE_INTERVAL=24h
# POOL_GROK_FREE_ACTIVATE_BATCH=3

# 网关 API Key（sk-gw-*）加密存储密钥；留空则回退 ADMIN_TOKEN，均为空时 Key 创建后无法再次显示
# GATEWAY_KEY_SECRET=
