# ==============================================================================
# 第一部分：极简引导层配置 (Bootstrap Layer)
# 注：VPS 部署或 GitHub Secret (VPS_ENV_CONTENT) 仅需维护以下引导连接参数；
#     业务密钥、号池策略、机场订阅等均已托管至管理台 #/settings 数据库配置中心。
# ==============================================================================

SERVER_HOST=0.0.0.0
SERVER_PORT=18080

# 运行时环境标识（home / office / vps），数据库按 Profile 隔离代理池与环境覆写项
APP_PROFILE=home

# 数据库连接（本地纯 Go SQLite 或 云端 Neon PostgreSQL；零 CGO）
# DATABASE_URL=postgres://user:pass@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=data/ai-web-free.db

# 物化双向同步架构（云端 PG 开启后本地走毫秒级 SQLite 读写 + 后台异步双向同步）
DB_MATERIALIZE_ENABLED=false
DB_LOCAL_PATH=data/ai-web-free.db
DB_SYNC_PUSH_INTERVAL=5s
DB_SYNC_PULL_INTERVAL=0
DB_SYNC_BATCH_SIZE=100
DB_SYNC_TIMEOUT=30s

# 管理台鉴权令牌与加密主密钥（同时用于加密数据库中的敏感配置与 sk-gw-* 网关密钥）
# ADMIN_TOKEN=
# GATEWAY_KEY_SECRET=

# 可选直连 TLS 证书（若使用 Cloudflare Tunnel / Nginx 反代则留空）
TLS_CERT=
TLS_KEY=

# 可选 Cloudflare Tunnel 自动穿透（配置后 setup_vps.sh / CD 自动托管 cloudflared）
# CF_TUNNEL_TOKEN=
# CF_TUNNEL_PROTOCOL=http2


# ==============================================================================
# 第二部分：业务与号池可选种子配置（已由管理台 #/settings 数据库配置中心托管）
# 注：首次启动时会将此处非空配置一次性自动导入数据库；后续请直接在前端
#     #/settings 界面查看、修改并零重启热重载，日常无需再改动 .env。
# ==============================================================================

# ─── 1. 多模态云端 Key & 通道 ───────────────────────────────────────────────────
# SILICONFLOW_API_KEY=                  # 硅基流动 API Key（支持逗号多 Key，解锁 FLUX / CosyVoice2 / CogVideoX）
# DASHSCOPE_API_KEY=                    # 阿里云百炼 API Key（支持逗号多 Key，解锁声音复刻 / 万相生图）
# GROK_SSO_COOKIES=                     # xAI Grok Web SSO Cookie (sso=...; sso-rw=...)
# GROK_CREDENTIAL_LLM_ENABLED=false
# GROK_CREDENTIAL_LLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
# LOCAL_TTS_BASE_URL=                   # 可选外部或本地 OpenAI 兼容 TTS 地址
# LOCAL_TTS_API_KEY=
# LOCAL_TTS_MODEL=kokoro
# RENDER_SERVICE_URL=                   # 可选外部 FFmpeg 短剧渲染服务地址

# ─── 2. Clash 订阅转 Mihomo 多端口池与出站代理 ─────────────────────────────────
PROXY_URL=
http_proxy=
# CLASH_SUB_URL=                        # 机场 Clash YAML / Base64 订阅链接
# CLASH_SUB_PROFILE=vps
# CLASH_MULTIPORT_HOST=127.0.0.1
# CLASH_MULTIPORT_START=20001
# CLASH_MULTIPORT_MAX=40
# CLASH_PRIORITY_REGIONS=US,JP,SG,TW,KR,DE,UK,NL,CA,AU
# CLASH_EXCLUDE_REGEX=(?i)(剩余|流量|到期|官网|重置|群|套餐|网址|失联|维护|测试|CN|中国|HK|香港|MO|澳门|RU|俄罗斯|BY|白俄罗斯|IR|伊朗|KP|朝鲜)
# MIHOMO_CONFIG_PATH=/etc/mihomo/config.yaml
# MIHOMO_API_URL=http://127.0.0.1:9090
# MIHOMO_API_SECRET=
# CLASH_SYNC_INTERVAL_HOURS=12

# ─── 3. 网关与对话协议 ─────────────────────────────────────────────────────────
Authorization=
API_REVERSE_PROXY=
FILES_REVERSE_PROXY=
BASE_URL=
STREAM_MODE=true
MAX_CONTINUE_COUNT=3
ENABLE_HISTORY=false
ENABLE_EXTERNAL_TOKEN=true
TOOL_CALLING_ENABLED=true
REFUSAL_RETRIES=3
# DEBUG_SENTINEL=false
# DEBUG_SSE=true
# DEBUG_TOOL_LOG=tool_debug.log

# ─── 4. 号池与热池策略 ─────────────────────────────────────────────────────────
POOL_CHATGPT_FREE_ACTIVE_TARGET=15
POOL_CHATGPT_FREE_MIN_HEALTHY=8
POOL_CHATGPT_FREE_MAX_ACTIVE=20
POOL_CHATGPT_FREE_ROTATE_INTERVAL=24h
POOL_CHATGPT_FREE_ROTATE_RATIO=0.2
POOL_CHATGPT_FREE_ACTIVATE_BATCH=5
# POOL_GROK_FREE_ACTIVE_TARGET=10
# POOL_GROK_FREE_MIN_HEALTHY=5
# POOL_GROK_FREE_MAX_ACTIVE=15
# POOL_GROK_FREE_ROTATE_INTERVAL=24h
# POOL_GROK_FREE_ACTIVATE_BATCH=3

FREE_ACCOUNTS=true
FREE_ACCOUNTS_NUM=1024
# KAMI_AUTO_RENEW=true
# KAMI_HEADLESS=true
# CHROME_PATH=/usr/bin/chromium
PROMPT_SYNC_INTERVAL_HOURS=6
# PROMPT_PLAZA_FILE=prompt_plaza_cache.json

# ─── 5. 存储、备份与审计 ───────────────────────────────────────────────────────
STORAGE_DIR=data/storage
